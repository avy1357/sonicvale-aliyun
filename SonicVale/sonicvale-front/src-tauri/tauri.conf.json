{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "轻语云配",
  "version": "1.1.5",
  "identifier": "com.example.qingyucloud",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "轻语云配",
        "width": 1360,
        "height": 765,
        "minWidth": 1024,
        "minHeight": 680,
        "maximized": true,
        "visible": false,
        "decorations": true,
        "fullscreen": false,
        "center": true,
        "icon": "icons/yingu.ico"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' data: blob: asset: http://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:8200 ws://127.0.0.1:8200 ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**",
          "$APPDATA/**",
          "$DOCUMENT/**",
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/yingu.ico"
    ],
    "resources": [
      "resources/main.exe",
      "resources/license.txt"
    ],
    "copyright": "Copyright © 2025 lxc",
    "category": "AudioVideo",
    "shortDescription": "AI 多角色多情绪配音平台",
    "longDescription": "轻语云配 (SonicVale) - 一个开源的多角色、多情绪 AI 配音生成平台,支持小说、剧本、视频等内容的自动配音与导出。",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "open-folder",
          "cmd": "explorer.exe",
          "args": [
            {
              "validator": "^.+$"
            }
          ]
        }
      ]
    }
  }
}
